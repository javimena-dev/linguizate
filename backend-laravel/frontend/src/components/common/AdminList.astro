---
import '../../styles/admin.css';
interface Props { id: string; title: string; columns: string[]; numericSort?: boolean }
const { id, title, columns, numericSort = false } = Astro.props;
---
<section class="admin-list" data-list={id} aria-label={title}>
  <div class="admin-list-controls">
    <label>Buscar <input type="search" data-search placeholder={`Buscar en ${title.toLowerCase()}...`} /></label>
    <label>Ordenar por
      <select data-sort>
        <option value="id">ID</option>
        {numericSort && <option value="score">Puntos</option>}
        {numericSort && <option value="gamesPlayed">Partidas</option>}
      </select>
    </label>
    <label>Dirección
      <select data-direction><option value="asc">Ascendente</option><option value="desc">Descendente</option></select>
    </label>
    <label>Por página
      <select data-size><option value="10">10</option><option value="15">15</option><option value="30">30</option><option value="50">50</option></select>
    </label>
  </div>
  <p class="admin-list-status" data-status role="status" aria-live="polite"></p>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead><tr>{columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
      <tbody data-body></tbody>
    </table>
  </div>
  <nav class="admin-pagination" aria-label={`Paginación de ${title.toLowerCase()}`}>
    <span data-count aria-live="polite"></span>
    <div><button type="button" class="btn-secondary" data-prev>Anterior</button><span data-page></span><button type="button" class="btn-secondary" data-next>Siguiente</button></div>
  </nav>
</section>
