---
import Brand from './Brand.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<main class="auth-grid">
  <section class="auth-story" aria-label="Lingüízate">
    <Brand />
    <div class="story-copy">
      <span class="eyebrow">Tutor lingüístico</span>
      <h2>Las palabras abren mundos.</h2>
      <p>Practica gramática, idiomas y escritura con respuestas claras, rápidas y personalizadas.</p>
    </div>
    <div class="story-orbit" aria-hidden="true">
      <span>Ñ</span><span>文</span><span>A</span><span>¿?</span>
    </div>
  </section>

  <section class="auth-panel">
    <div class="auth-card">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <slot />
    </div>
  </section>
</main>
