---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Activar cuenta docente - Lingüízate" showBack backUrl="/login">
  <section class="container container-auth-tight login-screen-layout">
    <div class="auth-form auth-card auth-form-compact">
      <h1 class="auth-title-compact"><i class="fas fa-chalkboard-teacher"></i> Activar cuenta docente</h1>
      <p>Define tu contraseña para completar la invitación.</p>
      <p id="message" class="auth-notification" hidden aria-live="polite"></p>
      <form id="invitation-form" novalidate>
        <div class="form-group">
          <label for="email">Correo invitado</label>
          <input id="email" type="email" autocomplete="email" readonly required />
        </div>
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input id="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" required />
        </div>
        <div class="form-group">
          <label for="confirmation">Confirmar contraseña</label>
          <input id="confirmation" type="password" autocomplete="new-password" minlength="8" maxlength="72" required />
        </div>
        <button id="submit" class="btn-primary btn-auth-submit" type="submit">Activar cuenta</button>
      </form>
    </div>
  </section>
</AppLayout>

<style>
  .form-group input { width:100%; box-sizing:border-box; padding:.72rem .8rem; border:1px solid #d4d9e3; border-radius:.55rem; }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { api } from '../scripts/api';

  const params = new URLSearchParams(location.search);
  const token = params.get('token') || '';
  const invitedEmail = params.get('email') || '';
  const form = document.querySelector<HTMLFormElement>('#invitation-form')!;
  const email = document.querySelector<HTMLInputElement>('#email')!;
  const password = document.querySelector<HTMLInputElement>('#password')!;
  const confirmation = document.querySelector<HTMLInputElement>('#confirmation')!;
  const submit = document.querySelector<HTMLButtonElement>('#submit')!;
  const message = document.querySelector<HTMLElement>('#message')!;

  const notice = (text: string, error = true) => {
    message.hidden = false;
    message.textContent = text;
    message.style.color = error ? '#c53030' : '#197149';
  };

  email.value = invitedEmail;
  if (!token || !invitedEmail) {
    notice('La invitación no contiene los datos requeridos.');
    submit.disabled = true;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (password.value.length < 8) return notice('La contraseña debe tener al menos 8 caracteres.');
    if (password.value !== confirmation.value) return notice('Las contraseñas no coinciden.');
    submit.disabled = true;
    try {
      const result = await api.post<{ message: string }>('/auth/invitations/accept', {
        email: invitedEmail,
        token,
        password: password.value,
        password_confirmation: confirmation.value
      });
      notice(result.message, false);
      window.setTimeout(() => void navigate('/login'), 1200);
    } catch (error: any) {
      notice(error?.message || 'No se pudo activar la cuenta docente.');
      submit.disabled = false;
    }
  });
</script>
