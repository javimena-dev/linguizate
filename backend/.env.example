# Copia este archivo a .env y rellena los valores.

# Puerto del servidor (por defecto 3000)
PORT=3000

# Clave secreta para firmar los JWT (cambiar en producción)
JWT_SECRET=linguizate-secret-cambiar-en-produccion

# Solo si el frontend se ejecuta en otro origen durante desarrollo
# FRONTEND_ORIGIN=http://localhost:5500

# Ruta alternativa de SQLite (opcional)
# DB_PATH=C:\ruta\linguizate.db

# Opción 1: Groq (gratis, muy rápido). Obtener en https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b

# Opción 2: OpenAI para el chat con IA (obtenerla en https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Máximo diario por estudiante y zona horaria de Bolivia (UTC-4)
CHAT_DAILY_LIMIT=10
CHAT_TIMEZONE_OFFSET_MINUTES=-240
