---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Sidebar from '../components/common/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  showBack?: boolean;
  backUrl?: string;
  backTitle?: string;
}

const { title, description, showBack = false, backUrl = '/', backTitle = 'Volver' } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <Navbar showBack={showBack} backUrl={backUrl} backTitle={backTitle} />
  <Sidebar />
  <main class="app-main-content">
    <slot />
  </main>
</BaseLayout>

<style>
  .app-main-content {
    min-height: calc(100vh - 70px);
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }
</style>
