---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Acceso - Lingüízate" showBack backUrl="/">
  <section class="container container-auth-tight login-screen-layout" id="auth-page">
    <div class="auth-form auth-card auth-form-compact">
      <div class="auth-form-logo auth-form-logo--in-card"><img src="/assets/images/portada/log.png" alt="Lingüízate" class="brand-logo-img brand-logo-img--auth" /></div>
      <h1 id="auth-title" class="auth-title-compact">Iniciar sesión</h1>
      <p id="auth-message" class="auth-notification" hidden aria-live="polite"></p>
      <a class="btn-primary btn-auth-submit google-login" href="/api/auth/google/redirect"><i class="fab fa-google"></i> Continuar con Google</a>
      <p class="auth-divider"><span>o</span></p>
      <form id="auth-form" novalidate>
        <div id="name-wrap" class="form-group" hidden><label for="name">Nombre completo</label><input id="name" autocomplete="name" /></div>
        <div class="form-group"><label for="email">Correo electrónico</label><input id="email" type="email" autocomplete="email" required /></div>
        <div class="form-group"><label for="password">Contraseña</label><input id="password" type="password" autocomplete="current-password" required /></div>
        <div id="confirm-wrap" class="form-group" hidden><label for="password-confirmation">Confirmar contraseña</label><input id="password-confirmation" type="password" autocomplete="new-password" /></div>
        <div id="gender-wrap" class="form-group" hidden><label for="gender">Género</label><select id="gender"><option value="otro">Prefiero no decirlo</option><option value="femenino">Femenino</option><option value="masculino">Masculino</option></select></div>
        <button id="submit" class="btn-primary btn-auth-submit" type="submit"><i class="fas fa-sign-in-alt"></i> Iniciar sesión</button>
      </form>
      <div class="auth-footer-links"><button id="toggle-mode" class="btn-link btn-link-compact" type="button">¿No tienes cuenta? Regístrate</button><a href="/recuperar-contrasena" class="btn-link btn-link-compact">¿Olvidaste tu contraseña?</a></div>
    </div>
  </section>
</AppLayout>

<style>
  .google-login { display: flex; align-items: center; justify-content: center; gap: .6rem; background: #fff; color: #263246; border: 1px solid #d9dee8; text-decoration: none; }
  .google-login:hover { background: #f8fafc; }
  .auth-divider { display: flex; align-items: center; gap: .75rem; color: #778196; margin: 1rem 0; font-size: .85rem; }
  .auth-divider::before, .auth-divider::after { content: ''; height: 1px; background: #e2e8f0; flex: 1; }
  .form-group input, .form-group select { width: 100%; box-sizing: border-box; padding: .72rem .8rem; border: 1px solid #d4d9e3; border-radius: .55rem; }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { api } from '../scripts/api';
  import { fetchCurrentSession, updateCurrentUser } from '../scripts/store';
  type Mode = 'login' | 'register';
  let mode: Mode = 'login';
  const form = document.querySelector<HTMLFormElement>('#auth-form')!;
  const title = document.querySelector<HTMLElement>('#auth-title')!;
  const message = document.querySelector<HTMLElement>('#auth-message')!;
  const submit = document.querySelector<HTMLButtonElement>('#submit')!;
  const toggle = document.querySelector<HTMLButtonElement>('#toggle-mode')!;
  const nameWrap = document.querySelector<HTMLElement>('#name-wrap')!;
  const confirmWrap = document.querySelector<HTMLElement>('#confirm-wrap')!;
  const genderWrap = document.querySelector<HTMLElement>('#gender-wrap')!;
  function showMessage(text: string, error = true) { message.hidden = false; message.textContent = text; message.style.color = error ? '#c53030' : '#197149'; }
  function render() { const registering = mode === 'register'; title.textContent = registering ? 'Crear cuenta de estudiante' : 'Iniciar sesión'; nameWrap.hidden = !registering; confirmWrap.hidden = !registering; genderWrap.hidden = !registering; submit.innerHTML = registering ? '<i class="fas fa-user-plus"></i> Crear cuenta' : '<i class="fas fa-sign-in-alt"></i> Iniciar sesión'; toggle.textContent = registering ? '¿Ya tienes cuenta? Inicia sesión' : '¿No tienes cuenta? Regístrate'; message.hidden = true; }
  toggle.addEventListener('click', () => { mode = mode === 'login' ? 'register' : 'login'; render(); });
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = document.querySelector<HTMLInputElement>('#email')!.value.trim();
    const password = document.querySelector<HTMLInputElement>('#password')!.value;
    if (!email || !password) return showMessage('Completa correo y contraseña.');
    submit.disabled = true;
    try {
      let result: any;
      if (mode === 'register') {
        const name = document.querySelector<HTMLInputElement>('#name')!.value.trim();
        const confirmation = document.querySelector<HTMLInputElement>('#password-confirmation')!.value;
        const gender = document.querySelector<HTMLSelectElement>('#gender')!.value;
        if (!name) throw new Error('Ingresa tu nombre.');
        if (password.length < 8) throw new Error('La contraseña debe tener al menos 8 caracteres.');
        if (password !== confirmation) throw new Error('Las contraseñas no coinciden.');
        result = await api.post('/auth/register', { name, email, password, password_confirmation: confirmation, gender });
      } else result = await api.post('/auth/login', { email, password });
      updateCurrentUser(result.user);
      await navigate(result.requiresVerification ? '/verificar-correo' : '/chat');
    } catch (error: any) { showMessage(error?.message || 'No se pudo completar la solicitud.'); } finally { submit.disabled = false; }
  });
  const google = new URLSearchParams(location.search).get('google');
  if (google) showMessage(google === 'email_not_verified' ? 'Google no confirmó ese correo.' : 'No se pudo iniciar sesión con Google.');
  fetchCurrentSession().then(async (user) => { if (user) await navigate(user.emailVerified ? '/chat' : '/verificar-correo'); });
</script>
