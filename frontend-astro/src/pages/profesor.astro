---
import AppLayout from '../layouts/AppLayout.astro';
import Select from '../components/ui/Select.astro';
import FileUpload from '../components/ui/FileUpload.astro';
---
<!-- Gestión docente: sin eliminación de registros. -->
<AppLayout title="Panel Docente - Lingüízate" showBack backUrl="/">
  <div class="container" id="professor-screen" style="max-width: 1050px; padding: 40px 16px;">
    <header style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
      <div>
        <h2 style="font-size: 2.2rem; margin-bottom: 4px;">
          <i class="fas fa-chalkboard-teacher" style="color: var(--primary-color); margin-right: 10px;"></i>
          Gestión Docente
        </h2>
        <p class="text-secondary">Crea categorías privadas, genera códigos para tus alumnos y revisa su rendimiento</p>
      </div>
      <button type="button" id="btn-create-category" class="btn-primary">
        <i class="fas fa-plus"></i> Nueva Categoría Privada
      </button>
    </header>

    <!-- Pestañas Docente -->
    <div style="display: flex; gap: 10px; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px; overflow-x: auto;">
      <button type="button" class="btn-secondary active" id="prof-tab-cats" data-prof-tab="categories">
        <i class="fas fa-tags"></i> Mis Categorías
      </button>
      <button type="button" class="btn-secondary" id="prof-tab-stats" data-prof-tab="stats">
        <i class="fas fa-chart-bar"></i> Rendimiento de Alumnos
      </button>
      <button type="button" class="btn-secondary" id="prof-tab-excel" data-prof-tab="excel">
        <i class="fas fa-file-excel"></i> Carga Masiva (Excel)
      </button>
    </div>

    <!-- Pestaña 1: Mis Categorías -->
    <div id="prof-sec-categories" class="prof-tab-content">
      <div id="prof-categories-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
        <p class="text-secondary" id="prof-cat-loading">Cargando tus categorías...</p>
      </div>
    </div>

    <!-- Pestaña 2: Estadísticas de Alumnos -->
    <div id="prof-sec-stats" class="prof-tab-content" style="display: none;">
      <div style="display:flex; justify-content:flex-end; margin-bottom:12px;">
        <button type="button" id="btn-export-stats" class="btn-secondary"><i class="fas fa-download"></i> Descargar Excel</button>
      </div>
      <div class="card responsive-table" style="background: var(--bg-primary); border-radius: var(--border-radius); border: 1px solid var(--border-color); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="border-bottom: 1px solid var(--table-row-border); background: var(--bg-secondary);">
              <th style="padding: 12px 18px;">Estudiante</th>
              <th style="padding: 12px 18px;">Categoría</th>
              <th style="padding: 12px 18px; text-align: right;">Aciertos</th>
              <th style="padding: 12px 18px; text-align: right;">Fallos</th>
              <th style="padding: 12px 18px; text-align: right;">Puntuación</th>
            </tr>
          </thead>
          <tbody id="prof-stats-tbody"></tbody>
        </table>
      </div>
    </div>

    <!-- Pestaña 3: Carga Masiva Excel -->
    <div id="prof-sec-excel" class="prof-tab-content" style="display: none;">
      <div class="card" style="background: var(--bg-primary); border-radius: var(--border-radius); border: 1px solid var(--border-color); padding: 24px;">
        <h3 style="font-size: 1.2rem; margin-bottom: 8px;">Importación de Preguntas desde Excel</h3>
        <p class="text-secondary" style="font-size: 0.95rem; margin-bottom: 20px;">
          Sube un archivo <code>.xlsx</code> con columnas: <em>Pregunta, Opción 1, Opción 2, Opción 3, Opción 4, Respuesta Correcta (0-3), Dificultad (facil, medio, dificil), Explicación</em>.
        </p>
        <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
          <Select id="excel-category-select" label="Categoría de destino" />
          <FileUpload id="excel-file-input" label="Archivo Excel" accept=".xlsx,.xls" hint="Formato .xlsx o .xls" />
          <button type="button" id="btn-process-excel" class="btn-primary">
            <i class="fas fa-upload"></i> Procesar e Importar
          </button>
        </div>
        <p id="excel-msg" style="display: none; margin-top: 14px; font-weight: 500;" aria-live="polite"></p>
        <div id="excel-preview" style="display:none; margin-top:14px;"></div>
      </div>
    </div>
  </div>

  <!-- Modal para Crear Nueva Categoría -->
  <div id="modal-create-cat" class="modal-overlay" style="display: none;">
    <div class="modal" style="max-width: 520px; width: 90%;">
      <div class="modal-header">
        <h3>Nueva Categoría Privada</h3>
        <button type="button" class="modal-close" id="modal-create-cat-close">&times;</button>
      </div>
      <div class="modal-body" style="padding: 20px;">
        <input id="editing-category-id" type="hidden" />
        <div class="form-group" style="margin-bottom: 16px;">
          <label style="display: block; font-weight: 600; margin-bottom: 6px;">Nombre de la Categoría *</label>
          <input type="text" id="new-cat-name" placeholder="Ej: Fonética Avanzada - Grupo B" style="width: 100%;" />
        </div>
        <div class="form-group" style="margin-bottom: 20px;">
          <label style="display: block; font-weight: 600; margin-bottom: 6px;">Descripción</label>
          <textarea id="new-cat-desc" rows="3" placeholder="Objetivo pedagógico o instrucciones para los estudiantes" style="width: 100%;"></textarea>
        </div>
        <button type="button" id="btn-submit-new-cat" class="btn-primary" style="width: 100%; justify-content: center;">
          <i class="fas fa-check"></i> Crear Categoría y Generar Código
        </button>
      </div>
    </div>
  </div>

  <div id="modal-question" class="modal-overlay" style="display:none;">
    <div class="modal" style="max-width: 680px; width: 94%;">
      <div class="modal-header"><h3 id="question-modal-title">Nueva pregunta</h3><button type="button" class="modal-close" id="modal-question-close">&times;</button></div>
      <form id="question-form" class="modal-body" style="padding:20px; display:grid; gap:12px;">
        <input id="question-category-id" type="hidden" /><input id="editing-question-id" type="hidden" />
        <label>Pregunta<textarea id="question-text-input" required rows="3" style="width:100%;"></textarea></label>
        <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px;" id="question-options-fields">
          <label>Opción 1<input required data-question-option="0" style="width:100%;" /></label><label>Opción 2<input required data-question-option="1" style="width:100%;" /></label><label>Opción 3<input required data-question-option="2" style="width:100%;" /></label><label>Opción 4<input required data-question-option="3" style="width:100%;" /></label>
        </div>
        <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px;"><label>Respuesta correcta<select id="question-correct-input" style="width:100%;"><option value="0">Opción 1</option><option value="1">Opción 2</option><option value="2">Opción 3</option><option value="3">Opción 4</option></select></label><label>Dificultad<select id="question-difficulty-input" style="width:100%;"><option value="facil">Fácil</option><option value="medio">Media</option><option value="dificil">Difícil</option></select></label></div>
        <label>Explicación<textarea id="question-explanation-input" rows="2" style="width:100%;"></textarea></label>
        <button type="submit" class="btn-primary" style="justify-content:center;">Guardar pregunta</button>
      </form>
    </div>
  </div>
  <div id="modal-manage-questions" class="modal-overlay" style="display:none;">
    <div class="modal" style="max-width:760px; width:94%;">
      <div class="modal-header"><h3>Preguntas de categoría</h3><button type="button" class="modal-close" id="modal-manage-questions-close">&times;</button></div>
      <div id="manage-questions-list" class="modal-body" style="padding:20px; max-height:65vh; overflow:auto;"></div>
    </div>
  </div>
</AppLayout>

<script>
  import { navigate } from 'astro:transitions/client';
  import { api } from '../scripts/api';
  import { $currentUser } from '../scripts/store';
  import { guardRoute } from '../scripts/guards';
  import { confirmAction, notify, runAsyncAction, skeletonCards } from '../scripts/feedback';

  async function setupProfesor() {
    const screen = document.getElementById('professor-screen');
    if (!screen || screen.dataset.initialized === 'true') return;
    screen.dataset.initialized = 'true';

    await guardRoute('profesor');
    const user = $currentUser.get();
    if (!user) return;

    const catListEl = document.getElementById('prof-categories-list');
    const statsTbody = document.getElementById('prof-stats-tbody');
    const tabBtns = document.querySelectorAll('[data-prof-tab]');
    const tabContents = document.querySelectorAll('.prof-tab-content');

    const modal = document.getElementById('modal-create-cat');
    const openModalBtn = document.getElementById('btn-create-category');
    const closeModalBtn = document.getElementById('modal-create-cat-close');
    const submitNewCatBtn = document.getElementById('btn-submit-new-cat') as HTMLButtonElement | null;
    const newNameInput = document.getElementById('new-cat-name') as HTMLInputElement | null;
    const newDescInput = document.getElementById('new-cat-desc') as HTMLTextAreaElement | null;
    const editingCategoryId = document.getElementById('editing-category-id') as HTMLInputElement | null;
    const excelCategorySelect = document.getElementById('excel-category-select') as HTMLSelectElement | null;
    const excelFileInput = document.getElementById('excel-file-input') as HTMLInputElement | null;
    const excelPreview = document.getElementById('excel-preview');
    const excelProcess = document.getElementById('btn-process-excel') as HTMLButtonElement | null;
    const questionModal = document.getElementById('modal-question');
    const manageQuestionsModal = document.getElementById('modal-manage-questions');
    const manageQuestionsList = document.getElementById('manage-questions-list');
    const questionForm = document.getElementById('question-form') as HTMLFormElement | null;
    let categories: any[] = [];
    let statistics: any[] = [];
    let pendingImport: any[] = [];
    const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' }[char]!));

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const tab = btn.getAttribute('data-prof-tab');

        tabContents.forEach((c: any) => {
          c.style.display = 'none';
        });

        const activeSec = document.getElementById(`prof-sec-${tab}`);
        if (activeSec) activeSec.style.display = 'block';

        if (tab === 'categories') void loadCategories();
        if (tab === 'stats') void loadStatistics();
      });
    });

    openModalBtn?.addEventListener('click', () => {
      if (editingCategoryId) editingCategoryId.value = '';
      if (newNameInput) newNameInput.value = '';
      if (newDescInput) newDescInput.value = '';
      if (modal) modal.style.display = 'flex';
    });
    closeModalBtn?.addEventListener('click', () => {
      if (modal) modal.style.display = 'none';
    });

    submitNewCatBtn?.addEventListener('click', async () => {
      const name = (newNameInput?.value || '').trim();
      const desc = (newDescInput?.value || '').trim();

      if (!name) {
        notify({ kind: 'warning', message: 'El nombre de la categoría es obligatorio.' });
        return;
      }

      await runAsyncAction(submitNewCatBtn, async () => {
        if (editingCategoryId?.value) {
          await api.patch(`/professor/categories/${editingCategoryId.value}`, { name, description: desc });
        } else {
          await api.post('/professor/categories', { name, description: desc });
        }
        if (modal) modal.style.display = 'none';
        if (newNameInput) newNameInput.value = '';
        if (newDescInput) newDescInput.value = '';
        void loadCategories();
      }, {
        loadingLabel: editingCategoryId?.value ? 'Guardando…' : 'Creando…',
        successMessage: 'Categoría guardada.',
        errorPrefix: 'Error al guardar categoría'
      });
    });

    async function loadCategories() {
      if (catListEl) catListEl.innerHTML = skeletonCards();
      try {
        const res = await api.get<{ categories: any[] }>('/professor/categories');
        const cats = res.categories || [];
        categories = cats;
        if (excelCategorySelect) {
          excelCategorySelect.innerHTML = cats.map((c) => `<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}</option>`).join('');
        }

        if (catListEl) {
          if (!cats.length) {
            catListEl.innerHTML = '<p class="text-secondary" style="grid-column: 1 / -1;">No has creado ninguna categoría privada todavía. Pulsa "Nueva Categoría Privada" para comenzar.</p>';
            return;
          }

          catListEl.innerHTML = cats
            .map((c) => {
              const qCount = c.subcategories?.[0]?.questionCount || 0;
              return `
                <div class="card" style="background: var(--bg-primary); border-radius: var(--border-radius); border: 1px solid var(--border-color); padding: 22px; display: flex; flex-direction: column; justify-content: space-between;">
                  <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                      <h3 style="font-size: 1.25rem;">${escapeHtml(c.name)}</h3>
                      <span style="font-size: 0.8rem; font-weight: 700; color: var(--primary-color); background: rgba(99, 102, 241, 0.1); padding: 3px 10px; border-radius: 12px;">
                        ${qCount} preguntas
                      </span>
                    </div>
                    <p class="text-secondary" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 16px;">
                      ${escapeHtml(c.description || 'Sin descripción')}
                    </p>
                  </div>

                  <div style="padding-top: 14px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                      <small class="text-secondary" style="display: block; font-size: 0.75rem;">Código de Alumnos</small>
                      <strong style="font-family: monospace; font-size: 1.15rem; color: var(--accent-color); letter-spacing: 1.5px;">${escapeHtml(c.accessCode || '—')}</strong>
                    </div>
                    <button type="button" class="btn-small btn-secondary" onclick="copyAccessCode('${escapeHtml(c.accessCode)}')">
                      <i class="fas fa-copy"></i> Copiar
                    </button>
                  </div>
                  <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap;">
                    <button type="button" class="btn-small btn-secondary" onclick="editProfessorCategory('${escapeHtml(c.id)}')"><i class="fas fa-pen"></i> Editar</button>
                    <button type="button" class="btn-small btn-primary" onclick="openProfessorQuestion('${escapeHtml(c.id)}')"><i class="fas fa-plus"></i> Pregunta</button>
                    <button type="button" class="btn-small btn-secondary" onclick="manageProfessorQuestions('${escapeHtml(c.id)}')"><i class="fas fa-pen"></i> Editar preguntas</button>
                  </div>
                </div>
              `;
            })
            .join('');
        }
      } catch (error: any) {
        if (catListEl) {
          catListEl.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 24px;">
              <p class="text-secondary" style="color: var(--error-color); margin-bottom: 12px;">No se pudieron cargar las categorías.</p>
              <button type="button" class="btn-secondary" id="btn-retry-cats"><i class="fas fa-redo"></i> Reintentar</button>
            </div>
          `;
          document.getElementById('btn-retry-cats')?.addEventListener('click', () => void loadCategories());
        }
        notify({ kind: 'error', message: error.message || 'No se pudieron cargar categorías.' });
      }
    }

    async function loadStatistics() {
      try {
        const res = await api.get<{ statistics: any[] }>('/professor/statistics');
        const stats = res.statistics || [];
        statistics = stats;
        if (statsTbody) {
          if (!stats.length) {
            statsTbody.innerHTML = '<tr><td colspan="5" style="padding: 20px; text-align: center; color: var(--text-secondary);">Aún no hay partidas registradas por tus alumnos.</td></tr>';
            return;
          }
          statsTbody.innerHTML = stats
            .map(
              (s) => `
              <tr style="border-bottom: 1px solid var(--table-row-border);">
                <td style="padding: 12px 18px; font-weight: 600;">${escapeHtml(s.studentName)}</td>
                <td style="padding: 12px 18px;">${escapeHtml(s.categoryName)}</td>
                <td style="padding: 12px 18px; text-align: right; color: var(--success-color); font-weight: 600;">${s.correctAnswers}</td>
                <td style="padding: 12px 18px; text-align: right; color: var(--error-color);">${s.incorrectAnswers}</td>
                <td style="padding: 12px 18px; text-align: right; font-weight: 700; color: var(--primary-color);">${s.score} pts</td>
              </tr>
            `
            )
            .join('');
        }
      } catch (error: any) {
        if (statsTbody) {
          statsTbody.innerHTML = `<tr><td colspan="5" style="padding: 20px; text-align: center; color: var(--error-color);">Error al cargar estadísticas. <button type="button" class="btn-small btn-secondary" id="btn-retry-stats"><i class="fas fa-redo"></i> Reintentar</button></td></tr>`;
          document.getElementById('btn-retry-stats')?.addEventListener('click', () => void loadStatistics());
        }
        notify({ kind: 'error', message: error.message || 'No se pudieron cargar estadísticas.' });
      }
    }

    (window as any).copyAccessCode = (code: string) => {
      navigator.clipboard.writeText(code).then(() => {
        notify({ kind: 'success', message: `Código ${code} copiado.` });
      });
    };

    (window as any).editProfessorCategory = (id: string) => {
      const category = categories.find((item) => item.id === id);
      if (!category) return;
      if (editingCategoryId) editingCategoryId.value = id;
      if (newNameInput) newNameInput.value = category.name;
      if (newDescInput) newDescInput.value = category.description || '';
      if (modal) modal.style.display = 'flex';
    };

    (window as any).openProfessorQuestion = (categoryId: string, questionId = '') => {
      questionForm?.reset();
      const category = categories.find((item) => item.id === categoryId);
      const question = category?.questions?.find((item: any) => item.id === questionId);
      (document.getElementById('question-category-id') as HTMLInputElement).value = categoryId;
      (document.getElementById('editing-question-id') as HTMLInputElement).value = question?.id || '';
      (document.getElementById('question-modal-title') as HTMLElement).textContent = question ? 'Editar pregunta' : 'Nueva pregunta';
      (document.getElementById('question-text-input') as HTMLTextAreaElement).value = question?.question || '';
      document.querySelectorAll<HTMLInputElement>('[data-question-option]').forEach((input, index) => input.value = question?.options?.[index] || '');
      (document.getElementById('question-correct-input') as HTMLSelectElement).value = String(question?.correct ?? 0);
      (document.getElementById('question-difficulty-input') as HTMLSelectElement).value = question?.difficulty || 'facil';
      (document.getElementById('question-explanation-input') as HTMLTextAreaElement).value = question?.explanation || '';
      if (manageQuestionsModal) manageQuestionsModal.style.display = 'none';
      if (questionModal) questionModal.style.display = 'flex';
    };

    (window as any).manageProfessorQuestions = (categoryId: string) => {
      const category = categories.find((item) => item.id === categoryId);
      if (!category || !manageQuestionsList) return;
      const questions = category.questions || [];
      manageQuestionsList.innerHTML = questions.length ? questions.map((question: any, index: number) => `<article style="padding:12px 0; border-bottom:1px solid var(--border-color); display:flex; justify-content:space-between; gap:12px; align-items:center;"><div><strong>${index + 1}. ${escapeHtml(question.question)}</strong><small class="text-secondary" style="display:block;">${escapeHtml(question.difficulty)} · ${escapeHtml(question.explanation || 'Sin explicación')}</small></div><button type="button" class="btn-small btn-secondary" onclick="openProfessorQuestion('${escapeHtml(categoryId)}','${escapeHtml(question.id)}')">Editar</button></article>`).join('') : '<p class="text-secondary">Aún no hay preguntas. Crea la primera.</p>';
      if (manageQuestionsModal) manageQuestionsModal.style.display = 'flex';
    };

    document.getElementById('modal-question-close')?.addEventListener('click', () => {
      if (questionModal) questionModal.style.display = 'none';
    });
    document.getElementById('modal-manage-questions-close')?.addEventListener('click', () => {
      if (manageQuestionsModal) manageQuestionsModal.style.display = 'none';
    });

    questionForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = questionForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      const categoryId = (document.getElementById('question-category-id') as HTMLInputElement).value;
      const questionId = (document.getElementById('editing-question-id') as HTMLInputElement).value;
      const payload = {
        question: (document.getElementById('question-text-input') as HTMLTextAreaElement).value.trim(),
        options: Array.from(document.querySelectorAll<HTMLInputElement>('[data-question-option]')).map((input) => input.value.trim()),
        correct: Number((document.getElementById('question-correct-input') as HTMLSelectElement).value),
        difficulty: (document.getElementById('question-difficulty-input') as HTMLSelectElement).value,
        explanation: (document.getElementById('question-explanation-input') as HTMLTextAreaElement).value.trim()
      };

      await runAsyncAction(button, async () => {
        if (questionId) await api.patch(`/professor/questions/${questionId}`, { ...payload, categoryId });
        else await api.post(`/professor/categories/${categoryId}/questions`, payload);
        if (questionModal) questionModal.style.display = 'none';
        void loadCategories();
      }, {
        loadingLabel: 'Guardando…',
        successMessage: 'Pregunta guardada.',
        errorPrefix: 'No se pudo guardar la pregunta'
      });
    });

    excelProcess?.addEventListener('click', async () => {
      const file = excelFileInput?.files?.[0];
      if (!file || !excelCategorySelect) {
        notify({ kind: 'warning', message: 'Selecciona categoría y archivo Excel.' });
        return;
      }

      await runAsyncAction(excelProcess, async () => {
        const { default: XLSX } = await import('xlsx');
        const workbook = XLSX.read(await file.arrayBuffer(), { type: 'array' });
        const rows = XLSX.utils.sheet_to_json<Record<string, unknown>>(workbook.Sheets[workbook.SheetNames[0]], { defval: '' });
        pendingImport = rows.map((row) => ({
          question: String(row['Pregunta'] || '').trim(),
          options: [1, 2, 3, 4].map((n) => String(row[`Opción ${n}`] || row[`Opcion ${n}`] || '').trim()),
          correct: Number(row['Respuesta Correcta'] ?? row['Respuesta'] ?? -1),
          difficulty: String(row['Dificultad'] || 'facil').toLowerCase().trim(),
          explanation: String(row['Explicación'] || row['Explicacion'] || '').trim()
        }));
        const invalid = pendingImport.filter((q) => !q.question || q.options.some((o) => !o) || !Number.isInteger(q.correct) || q.correct < 0 || q.correct > 3 || !['facil', 'medio', 'dificil'].includes(q.difficulty));
        if (excelPreview) {
          excelPreview.style.display = 'block';
          excelPreview.innerHTML = invalid.length
            ? `<span class="text-secondary">${pendingImport.length} filas; ${invalid.length} inválidas.</span>`
            : `<button type="button" id="btn-confirm-import" class="btn-primary">Importar ${pendingImport.length} preguntas</button>`;
        }
        document.getElementById('btn-confirm-import')?.addEventListener('click', () => void importExcel());
      }, {
        loadingLabel: 'Validando…',
        errorPrefix: 'No se pudo leer el archivo Excel'
      });
    });

    async function importExcel() {
      const button = document.getElementById('btn-confirm-import') as HTMLButtonElement | null;
      if (!button || !excelCategorySelect || !pendingImport.length) return;
      if (!await confirmAction({ title: 'Importar preguntas', message: `Se crearán ${pendingImport.length} preguntas. No se eliminarán datos.`, confirmLabel: 'Importar' })) return;

      await runAsyncAction(button, async () => {
        const result = await api.post<{ created: number }>(`/professor/categories/${excelCategorySelect.value}/questions/import`, { questions: pendingImport });
        if (excelPreview) excelPreview.style.display = 'none';
        if (excelFileInput) excelFileInput.value = '';
        void loadCategories();
      }, {
        loadingLabel: 'Importando…',
        successMessage: `${pendingImport.length} preguntas importadas con éxito.`,
        errorPrefix: 'No se pudo importar'
      });
    }

    document.getElementById('btn-export-stats')?.addEventListener('click', async (event) => {
      if (!statistics.length) {
        notify({ kind: 'warning', message: 'No hay estadísticas para exportar.' });
        return;
      }
      const button = event.currentTarget as HTMLButtonElement;
      await runAsyncAction(button, async () => {
        const { default: XLSX } = await import('xlsx');
        const sheet = XLSX.utils.json_to_sheet(statistics.map((s) => ({
          Estudiante: s.studentName,
          Categoría: s.categoryName,
          Aciertos: s.correctAnswers,
          Fallos: s.incorrectAnswers,
          Puntos: s.score,
          Fecha: s.date
        })));
        const book = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(book, sheet, 'Estadísticas');
        XLSX.writeFile(book, `linguizate_reporte_${new Date().toISOString().slice(0, 10)}.xlsx`);
      }, {
        loadingLabel: 'Generando…',
        successMessage: 'Reporte Excel descargado.',
        errorPrefix: 'Error al exportar reporte'
      });
    });

    void loadCategories();
  }

  setupProfesor();
  document.addEventListener('astro:page-load', setupProfesor);
</script>
